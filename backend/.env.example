# Contoh konfigurasi backend CrediPredict.
#
# Cara pakai:
#   cp .env.example .env
# lalu sesuaikan nilainya. File ".env" TIDAK ikut di-commit
# karena berisi kredensial.
#
# CATATAN: app.py saat ini hanya membaca ADMIN_SECRET_CODE.
# Variabel lain disediakan untuk pengembangan berikutnya.

# Kode rahasia untuk mendaftarkan akun admin baru (WAJIB diganti!)
ADMIN_SECRET_CODE=ganti-dengan-kode-rahasia-anda

# Opsional - pengaturan sesi login
TOKEN_TTL_HOURS=24
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Opsional - mode debug Flask (jangan aktifkan saat produksi)
FLASK_DEBUG=false
